<?php
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');

$siteTitle = $site->title();

$browseBodyTruncation = $this->themeSetting('browse_body_truncation')
    ?: 'fade';

$banner = $this->themeSettingAssetUrl('banner');

$this->htmlElement('html')->setAttribute('lang', $this->lang());

$this->headMeta()->setCharset('utf-8');
$this->headMeta()->appendName(
    'viewport',
    'width=device-width, initial-scale=1'
);

$this->headTitle($siteTitle)->setSeparator(' · ');
$this->headTitle()->append(
    $this->setting('installation_title', 'Omeka S')
);

/*
 * Omeka core assets.
 */
$this->headLink()->prependStylesheet(
    $this->assetUrl('css/iconfonts.css', 'Omeka')
);

$this->headScript()->prependFile(
    $this->assetUrl('js/global.js', 'Omeka')
);

$this->headScript()->prependFile(
    $this->assetUrl('vendor/jquery/jquery.min.js', 'Omeka')
);

/*
 * Digital Heritage GY assets.
 */
$this->headLink()->appendStylesheet(
    $this->assetUrl('css/main.css')
);

$this->headScript()->appendFile(
    $this->assetUrl('js/main.js')
);

$this->jsTranslate();

$this->htmlElement('body')->appendAttribute(
    'class',
    'body-truncate-' . $browseBodyTruncation
);

$this->trigger('view.layout');

$userBar = $this->userBar();
$requestUri = $_SERVER['REQUEST_URI'] ?? '';
$showHomepageHero =
    $requestUri === '/'
    || preg_match('#^/s/[^/]+/?$#', $requestUri)
    || strpos($requestUri, '/page/home') !== false;
?>

<?php echo $this->doctype(); ?>

<?php echo $this->htmlElement('html'); ?>

<head>
    <?php echo $this->headMeta(); ?>
    <?php echo $this->headTitle(); ?>
    <?php echo $this->headLink(); ?>
    <?php echo $this->headStyle(); ?>
    <?php echo $this->headScript(); ?>
</head>

<?php echo $this->htmlElement('body'); ?>

<a id="skipnav" href="#content">
    <?php echo $translate('Skip to main content'); ?>
</a>

<?php echo $userBar; ?>

<header class="site-header">
    <div class="container">
        <h1 class="site-title">
            <a href="<?php echo $site->url(); ?>">
                <?php if ($this->themeSetting('logo')): ?>
                    <img
                        src="<?php echo $this->themeSettingAssetUrl('logo'); ?>"
                        alt="<?php echo $escape($siteTitle); ?>"
                    >
                <?php else: ?>
                    <?php echo $escape($siteTitle); ?>
                <?php endif; ?>
            </a>
        </h1>

        <nav
            id="top-nav"
            class="site-navigation"
            aria-label="<?php echo $translate('Main navigation'); ?>"
        >
            <button
                type="button"
                id="mobile-nav-toggle"
                aria-expanded="false"
                aria-controls="top-nav-contents"
                aria-label="<?php echo $translate('Toggle menu'); ?>"
            >
                <span aria-hidden="true">☰</span>
            </button>

            <?php
            echo $site->publicNav()
                ->menu()
                ->renderMenu(null, [
                    'maxDepth' => max(
                        0,
                        (int) $this->themeSetting('nav_depth') - 1
                    ),
                    'id' => 'top-nav-contents',
                ]);
            ?>
        </nav>
    </div>

    <?php if ($banner): ?>
        <div class="banner">
            <img
                src="<?php echo $banner; ?>"
                alt=""
                role="presentation"
            >
        </div>
    <?php endif; ?>
</header>

<?php if ($showHomepageHero): ?>
<section class="barima-hero">
    <img
        class="barima-hero-image"
        src="<?= $this->assetUrl('img/mv-barima.png', 'DigitalHeritageGY'); ?>"
        alt="MV Barima"
    >

    <div class="barima-hero-text">
        <p class="barima-intro">In Memory of</p>
        <h1>MV Barima</h1>
        <p>Remembering the lives, journeys and stories connected to the vessel</p>
    </div>
</section>
<?php endif; ?>

<main id="content" class="site-content" role="main">
    <div class="container">
        <?php echo $this->content; ?>
    </div>
</main>

<footer class="site-footer">
    <div class="container">
        <?php if ($footerContent = $this->themeSetting('footer')): ?>
            <?php echo $footerContent; ?>
        <?php else: ?>
            <p>
                <?php echo $translate('Powered by Omeka S'); ?>
            </p>
        <?php endif; ?>
    </div>
</footer>

</body>
</html>
